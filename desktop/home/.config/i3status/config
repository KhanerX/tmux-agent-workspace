general {
    output_format = "i3bar"
    colors = true
    interval = 5
    color_good = "#05ffa1"
    color_degraded = "#f9f871"
    color_bad = "#ff2a6d"
}

order += "battery all"
order += "ethernet _first_"
order += "disk /"
order += "load"
order += "memory"
order += "tztime local"

battery all {
    format = "BAT %status %percentage %remaining"
}
ethernet _first_ {
    format_up = "NET %ip"
    format_down = "NET --"
}
disk "/" {
    format = "SSD %avail"
}
load {
    format = "CPU %1min"
}
memory {
    format = "RAM %used"
    threshold_degraded = "1G"
}
tztime local {
    format = "%a %Y-%m-%d %H:%M"
}
